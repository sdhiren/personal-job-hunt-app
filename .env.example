# Copy to .env and adjust. Read by the app (make run) and by docker compose; .env is gitignored.
#
# Values may contain any character. If one contains `$`, wrap it in single quotes, otherwise docker compose
# treats `$NAME` as a variable:   POSTGRES_PASSWORD='My$ecret@123'

# PostgreSQL (the compose `db` service). These are applied only when the database is first created; to
# change them later, see "Database commands" in the README.
POSTGRES_USER=jobhunt
POSTGRES_PASSWORD=jobhunt
POSTGRES_DB=jobhunt
# Port on your machine; change it if another PostgreSQL already uses 5432
POSTGRES_PORT=5432

# Use a different PostgreSQL for `make run` instead of the compose one:
# DATABASE_URL=postgresql://user:password@localhost:5432/jobhunt

# Port for the app (make run and make up), and for the Docker browser viewer (noVNC)
# JOBHUNT_PORT=8765
# JOBHUNT_VNC_PORT=6080

# Extra host names the app may be opened as (comma-separated). Only localhost / 127.0.0.1 are accepted by
# default, which blocks other websites from driving the app (DNS rebinding).
# JOBHUNT_ALLOWED_HOSTS=

# Ask for a password in the application browser viewer (noVNC). Optional: it is published to localhost only.
# JOBHUNT_VNC_PASSWORD=

# Claude account inside Docker without an interactive login: create a token on your computer with
# `claude setup-token` and paste it here (alternative to `make docker-claude-login`).
# CLAUDE_CODE_OAUTH_TOKEN=

# Skip installing Claude Code in the image (if you only use an API key or no Claude)
# INSTALL_CLAUDE_CODE=0
